    { "id": "core.yearRelax", "label": "No B plan: relax one must at a time", "fn": "searchYear (relax)", "ref": "web/solver-core.js:455-479", "inputs": "coursesB musts, pins", "outputs": "rb with fewer musts", "reads": [], "writes": [], "next": ["core.yearPairScore"], "findings": ["F-12"] },
    { "id": "core.yearPairScore", "label": "Score the pair, list missing musts", "fn": "searchYear (pair)", "ref": "web/solver-core.js:480-498", "inputs": "a, b", "outputs": "pair", "reads": ["SHARE/LOAD_W/MISSING_W web/solver-core.js:375-379"], "writes": [], "next": ["core.yearSort"] },
    { "id": "core.yearSort", "label": "Rank pairs, keep top 10", "fn": "searchYear (end)", "ref": "web/solver-core.js:499-501", "inputs": "pairs", "outputs": "reply", "reads": [], "writes": [], "next": ["ui.onmessage"] },
    { "id": "core.search", "label": "Search one semester (branch and bound)", "fn": "search", "ref": "web/solver-core.js:248-373", "inputs": "semesterRequest", "outputs": "reply", "reads": [], "writes": [], "next": ["core.forbidden"] },
    { "id": "core.forbidden", "label": "Hard time limits to a week mask", "fn": "forbiddenMask / meetingsMask / lateMask", "ref": "web/solver-core.js:33-44", "inputs": "constraints.blocks/dayOff/notBefore/notAfter + hard flags", "outputs": "forbidden[7]", "reads": [], "writes": [], "next": ["core.value"], "notes": "grid web/solver-core.js:4-31 (30-min slots from 07:00)", "findings": ["F-04", "F-05", "F-06"] },
    { "id": "core.value", "label": "Course value: credits + unlocks + chain depth", "fn": "downstream / chainDepth / courseValue", "ref": "web/solver-core.js:113-161", "inputs": "dataset", "outputs": "value{id}", "reads": ["prereqs (קדם only)"], "writes": ["DOWN WeakMap cache"], "next": ["core.items"], "findings": ["F-03", "F-15"] },
    { "id": "core.items", "label": "Build each course's registration options", "fn": "buildOptions / byLecturer", "ref": "web/solver-core.js:256-263", "inputs": "courses, pins, includeFull, forbidden, friends, lecturers", "outputs": "items sorted by option count", "reads": ["groups"], "writes": [], "next": ["core.prefMask"], "notes": "buildOptions web/solver-core.js:54-102, byLecturer :49-53", "findings": ["F-01", "F-08", "F-09", "F-10"] },
