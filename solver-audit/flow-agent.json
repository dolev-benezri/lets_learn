    { "id": "ui.onmessage", "label": "Store the answer, redraw", "fn": "worker.onmessage", "ref": "web/ui-search.js:35-36", "inputs": "reply", "outputs": "ui.last, ui.cur=0", "reads": [], "writes": ["ui.last", "ui.cur", "ui.running"], "next": ["ui.renderView"], "findings": ["F-02"] },
