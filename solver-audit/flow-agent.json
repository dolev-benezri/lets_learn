    { "id": "ui.renderWeek", "label": "Draw the week grid", "fn": "renderWeek", "ref": "web/ui-grid.js:187-207", "inputs": "data, res, colors, pins, friends", "outputs": "HTML", "reads": ["res.groups"], "writes": [], "next": [] },
    { "id": "ui.renderSide", "label": "Draw the course list with statuses", "fn": "renderSide", "ref": "web/ui-side.js:58-88", "inputs": "raw result", "outputs": "HTML", "reads": ["app.cls.statuses", "unlockCounts (web/solver-core.js:134-137)"], "writes": ["DOM"], "next": [], "findings": ["F-03"] },
    { "id": "ui.go", "label": "User browses alternatives", "fn": "go", "ref": "web/ui-view.js:155-160", "inputs": "+1/-1", "outputs": "ui.cur", "reads": ["ui.last.results.length"], "writes": ["ui.cur"], "next": ["ui.renderView"] }
