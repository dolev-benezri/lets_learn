{
  "about": "Flow from user input to displayed schedule in the Afeka scheduler. Nodes = steps (function + path:line), edges = 'leads to'. Refs are repo-relative; check them with node solver-audit/repro/meta-check-refs.mjs. Findings that touch a node are listed in its 'findings' field (ids from solver-audit/findings.md).",
  "structures": {
    "state": "app.state (web/app.js:9-17 DEFAULT, normalize web/app.js:45-80): {program,startYear,year,scope:'year'|'א'|'ב'|'קיץ',passed[],failed{id:n},choices{id:'must'|'optional'|'no'},pins[groupId],friends[{name,groups[],weight 0..3,active}],profile{year,amirnet,specs[],summer},load:'א'|'even'|'ב',semesterOf{id:'א'|'ב'},weights{friends,progress,freeDays,compact,timeWindow,examSpread in 0/1/3/5},constraints{dayOff[],dayOffHard,notBefore,notAfter,windowHard,maxCredits,maxDays,examsSameDay,includeFull,blocks[{day,start,end,label}],lecturers{name:'prefer'|'avoid'}}}",
    "dataset": "semester file: {year,startYear,program,semester,examsPublished,fetchedAt,lists[{code,name,minCredits,courses[]}],specializations[],specRule,degree,courses{id:{name,credits,offered,prereqs[{kind:'קדם'|'מקביל',anyOf[{id|null,name}]}],groups[{id,type,primary,lecturer,full,semester,linked[ids],meetings[{day 1..6,start,end,room}],exams[{kind,moed,date,time}]}]}}}",
    "statuses": "classify() output: {statuses{id:{status:'done'|'exempt'|'notOffered'|'retake'|'blocked'|'conditional'|'available'|'afterA',reasons[],blockedBy?[],missingParallel?[[ids]]}},warnings[]}",
    "semesterRequest": "{data,courses[{id,mode:'must'|'optional'}],statuses,pins,constraints,weights,friends,timeLimitMs} (web/ui-search.js:40)",
    "yearRequest": "{year:{dataA,dataB,state,yearList:Set,pins,constraints,weights,friends,timeLimitMs}} (web/ui-search.js:38-39)",
    "option": "buildOptions element: {groups[ids],mask[7 ints, 30-min bits from 07:00],meetings[],exams[moed-1 dates],allExams[],minutes,sharedMin[per friend],sharesWith[per friend],alts{primary:[identical primaries]},course}",
    "item": "{id,mode,credits,options[]} sorted by options.length (web/solver-core.js:256-263)",
    "result": "{score,breakdown{friends,progress,freeDays,compact,timeWindow,examSpread},groups[],courses[],unlocks,explanation,alts{},exams[]} (web/solver-core.js:335-339)",
    "pair": "{score,a:result,b:result|null,credits{a,b},missing[],warnings[]} (web/solver-core.js:493-497)",
    "reply": "{results[result|pair],partial,diagnosis[]} stored as ui.last = {...reply, ms} (web/ui-search.js:35)"
  },
  "nodes": [
    { "id": "app.entry", "label": "Page loads the app module", "fn": "<script type=module>", "ref": "web/index.html:77", "inputs": "-", "outputs": "runs web/ui-plan.js (imports app.js which calls init)", "reads": [], "writes": [], "next": ["app.init"] },
    { "id": "app.init", "label": "Load catalog, saved state, data files", "fn": "init", "ref": "web/app.js:287-312", "inputs": "catalog.json, localStorage", "outputs": "app.catalog, app.state, app.sem", "reads": ["localStorage afeka-sched-v1"], "writes": ["app.catalog", "app.state", "app.status", "app.loadFailed"], "next": ["app.load", "app.fetchSemesters"] },
    { "id": "app.load", "label": "Restore saved state through normalize", "fn": "load / normalize", "ref": "web/app.js:83-102", "inputs": "raw saved JSON", "outputs": "state (only valid values)", "reads": ["localStorage"], "writes": ["app.state", "app.noSave", "app.hashError"], "next": ["app.fetchSemesters"], "notes": "normalize web/app.js:45-80; CONSTRAINT_OK web/app.js:33-41 admits maxCredits 0 and any HH:MM", "findings": ["F-07"] },
    { "id": "app.fetchSemesters", "label": "Fetch semester A, B and summer files", "fn": "fetchSemesters", "ref": "web/app.js:229-238", "inputs": "state.year/program/startYear", "outputs": "{א,ב,קיץ} datasets (B/summer may be null)", "reads": ["web/data/afeka/<y>-<n>/<program>-<start>.json"], "writes": [], "next": ["app.setSemesters"] },
    { "id": "app.setSemesters", "label": "Keep datasets, pick the one to show", "fn": "setSemesters / pickData / yearView", "ref": "web/app.js:239-244", "inputs": "sem", "outputs": "app.data = yearView(A,B) | A | B | summer", "reads": ["app.state.scope"], "writes": ["app.sem", "app.data", "app.semNotice"], "next": ["app.applyHash"], "notes": "pickData web/app.js:152-155, yearView web/app.js:134-142 (merges groups; A's course record wins)" },
    { "id": "app.applyHash", "label": "Apply friend/backup link, default passed courses", "fn": "applyHash / ensurePassed", "ref": "web/app.js:333-351", "inputs": "location.hash", "outputs": "state.passed defaulted to earlier years' mandatory lists", "reads": ["location.hash"], "writes": ["app.state.passed", "app.friendLanding"], "next": ["app.refresh"], "notes": "ensurePassed web/app.js:166, earlierYears web/app.js:162-165" },
    { "id": "app.refresh", "label": "Classify every course, save, render", "fn": "refresh", "ref": "web/app.js:211-221", "inputs": "app.state, app.data", "outputs": "app.cls", "reads": ["app.state", "app.data", "app.sem"], "writes": ["app.cls", "localStorage"], "next": ["rules.classify", "ui.renderAll"], "notes": "withAfterA(app.data, st, classify(app.data, st)) at web/app.js:217; summerOnly at :218" },
    { "id": "rules.classify", "label": "Give each course a status", "fn": "classify", "ref": "web/rules.js:61-126", "inputs": "dataset, state{passed,failed,profile.amirnet}", "outputs": "statuses", "reads": ["data.courses[].prereqs/offered", "state.passed/failed"], "writes": [], "next": ["rules.withAfterA"], "findings": ["F-03", "F-19"] },
    { "id": "rules.withAfterA", "label": "Year view: mark courses open after A", "fn": "withAfterA", "ref": "web/rules.js:130-144", "inputs": "data (semester 'שנה'), state, cls", "outputs": "statuses with afterA", "reads": [], "writes": [], "next": ["ui.renderAll"] },
    { "id": "ui.renderAll", "label": "Draw the page, then start a search", "fn": "renderAll", "ref": "web/ui-plan.js:53-61", "inputs": "app.*", "outputs": "DOM", "reads": ["app.cls", "ui.last"], "writes": ["DOM"], "next": ["ui.renderView", "ui.scheduleRun"], "notes": "registered as the renderer at web/ui-plan.js:125" },
    { "id": "ui.userChange", "label": "User changes a preference or course mode", "fn": "change dispatcher -> CHG[...]", "ref": "web/ui-plan.js:69-78", "inputs": "DOM change event", "outputs": "state mutation; 'quiet' -> save + scheduleRun, else refresh", "reads": [], "writes": ["app.state.*"], "next": ["ui.scheduleRun", "app.refresh"], "notes": "constraint handlers web/ui-actions.js:230-233; controls web/ui-drawer.js:38-50", "findings": ["F-07", "F-17"] },
    { "id": "ui.moreClick", "label": "User asks to search longer", "fn": "ACT.more", "ref": "web/ui-actions.js:64-70", "inputs": "click", "outputs": "ui.moreMul *= 2", "reads": ["ui.running"], "writes": ["ui.moreMul"], "next": ["ui.scheduleRun"] },
    { "id": "ui.scheduleRun", "label": "Debounce a new search 300 ms", "fn": "scheduleRun", "ref": "web/ui-search.js:8-16", "inputs": "again flag", "outputs": "timer -> run", "reads": ["gated()"], "writes": ["ui.gen", "ui.running", "ui.timer", "ui.moreMul"], "next": ["ui.run"], "findings": ["F-02"] },
    { "id": "ui.run", "label": "Build the request from state", "fn": "run", "ref": "web/ui-search.js:17-41", "inputs": "app.state, app.data, app.cls", "outputs": "semesterRequest or yearRequest", "reads": ["candidateMode (web/app.js:180)", "yearCourses (web/app.js:174-179)", "rules.modeFor (web/rules.js:180-185)"], "writes": ["ui.worker", "ui.runError"], "next": ["ui.worker"], "notes": "budget ms at web/ui-search.js:21; pins filtered for semester (:37) but not for year (:38)" },
    { "id": "ui.worker", "label": "Worker runs the solver off the main thread", "fn": "self.onmessage", "ref": "web/solver-worker.js:3", "inputs": "request", "outputs": "reply via postMessage", "reads": [], "writes": [], "next": ["core.search", "core.searchYear"] },
    { "id": "core.searchYear", "label": "Plan the year: A plans x best B plan", "fn": "searchYear", "ref": "web/solver-core.js:382-501", "inputs": "yearRequest.year", "outputs": "reply with pairs", "reads": ["dataA", "dataB", "state"], "writes": [], "next": ["core.yearClassifyA"], "findings": ["F-11", "F-12"] },
    { "id": "core.yearClassifyA", "label": "Classify A, choose A candidates and musts", "fn": "searchYear (part)", "ref": "web/solver-core.js:389-401", "inputs": "dataA, state, yearList", "outputs": "coursesA, bias, must", "reads": ["state.choices/semesterOf/load", "pins"], "writes": [], "next": ["core.yearMax"] },
    { "id": "core.yearMax", "label": "Year progress denominator over both semesters", "fn": "searchYear (part)", "ref": "web/solver-core.js:402-417", "inputs": "coursesA, dataB", "outputs": "stY, yearMax, must (B part)", "reads": [], "writes": [], "next": ["core.yearSearchA"] },
    { "id": "core.yearSearchA", "label": "Find top 50 semester-A plans", "fn": "search (A)", "ref": "web/solver-core.js:419-420", "inputs": "coursesA, topK 50, 60% of budget", "outputs": "ra", "reads": [], "writes": [], "next": ["core.search", "core.yearSeeds"] },
    { "id": "core.yearSeeds", "label": "Add A plans that open B musts", "fn": "searchYear (part)", "ref": "web/solver-core.js:428-441", "inputs": "must, ra", "outputs": "aList (+ empty A plan if nothing is must in A)", "reads": [], "writes": [], "next": ["core.yearPairLoop"], "findings": ["F-12"] },
