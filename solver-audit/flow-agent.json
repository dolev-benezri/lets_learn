    { "id": "core.boundSetup", "label": "Prepare optimistic bounds for pruning", "fn": "search (part) / bound", "ref": "web/solver-core.js:281-322", "inputs": "items, weights, friends", "outputs": "canPrune, restValue, restShared, bound()", "reads": [], "writes": [], "next": ["core.dfs"], "findings": ["F-20"] },
